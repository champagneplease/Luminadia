datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPERADMIN
  INSTALLER
}

enum RequestStatus {
  NUEVA
  EN_ANALISIS
  CONTACTADO
  INSTALADO
  ARCHIVADO
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model FilmProduct {
  id                      String   @id @default(uuid())
  name                    String
  slug                    String   @unique
  code                    String?
  description             String
  categories              String[] // ['automotriz', 'hogares', 'comercios-empresas']
  rollWidthMeters         Float    @default(1.52)
  usableWidthMeters       Float    @default(1.50)
  standardRollLengthMeters Float   @default(30.0)
  vltPercent              Int?     // Visible Light Transmission
  uvRejectionPercent      Int?     @default(99)
  irRejectionPercent      Int?
  tserPercent             Int?     // Total Solar Energy Rejected
  colorShade              String?
  technology              String?
  warrantyYears           Int?     @default(5)
  active                  Boolean  @default(true)
  order                   Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("film_products")
}

model CalculatorRequest {
  id                    String        @id @default(uuid())
  category              String        // automotriz, hogares, comercios-empresas
  productId             String?
  productName           String?
  contactName           String
  contactPhone          String
  contactEmail          String?
  vehicleDetails        String?
  notes                 String?
  netSurfaceAreaM2      Float?
  estimatedLinearMeters Float?
  rollWidthUsed         Float?
  piecesCount           Int?
  calculationDetailJson Json?
  status                RequestStatus @default(NUEVA)
  internalNotes         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("calculator_requests")
}

model ContentPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String?
  contentJson Json?
  isPublished Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("content_pages")
}

model MediaAsset {
  id           String   @id @default(uuid())
  publicId     String   @unique
  url          String
  secureUrl    String
  format       String?
  bytes        Int?
  width        Int?
  height       Int?
  altText      String?
  resourceType String   @default("image") // image, video
  createdAt    DateTime @default(now())

  @@map("media_assets")
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String?
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}
